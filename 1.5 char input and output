// 1.5 character input and output

// copy input to output ; 1st version
main()
{
	int c;
	c = getchar();
	while (c != EOF) {
		putchar(c);
		c = getchar();
	}
}


// copy input to output ; 2nd version
main()
{
	int c;
	while ((c = getchar()) != EOF) {
		putchar(c);
	}
}

// 1.5.2 character counting

#include <stdio.h>


// count characters in input, 1st version

main ()
{
	long nc;

	nc = 0;
	while(getchar() != EOF)
		++nc;
	printf("%ld\n", nc);
}


// count characters in input, 2nd version

main ()
