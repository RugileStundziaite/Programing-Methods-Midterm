#include <stdio.h>

#define TABSTOP 8

int main()
{
    int c;
    int spaces = 0;
    int pos = 0;

    while ((c = getchar()) != EOF)
    {
        if (c == ' ')
        {
            ++spaces;
            ++pos;

            if (pos % TABSTOP == 0)
            {
                putchar('\t');
                spaces = 0;
            }
        }
        else
        {
            while (spaces > 0)
            {
                putchar(' ');
                --spaces;
            }

            putchar(c);

            if (c == '\n')
                pos = 0;
            else
                ++pos;
        }
    }

    return 0;
}
